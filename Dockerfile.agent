# Client v2 image: runs seawise-agent. Published only under the :2.x.y, :2,
# :beta and :stable tags (never :latest); the v1 image is built from Dockerfile.
#
# By default the container starts as root only to switch to PUID/PGID
# (default 1000:1000), so installs upgraded from the v1 image keep their
# PUID/PGID settings and data folder ownership. The agent itself never runs
# as root. All state lives under /config, so the root filesystem can be
# read-only. Recommended: start it as the user directly, which needs no
# capabilities at all:
#   docker run --read-only --cap-drop ALL --security-opt no-new-privileges \
#     --user 1000:1000 -v ./config:/config -p 127.0.0.1:8082:8082 <image>
# Without --user, keep CHOWN, SETUID and SETGID.

ARG BUILDPLATFORM=linux/amd64

# Build stage: pinned by digest; bump with go.mod's toolchain version
FROM --platform=$BUILDPLATFORM golang:1.26.9-alpine@sha256:cdfd4fe2da6b225d8b40c6b7a105736e548e83ff56d5d8f9394446eeb5eb84e0 AS builder

WORKDIR /src
COPY go.mod go.sum ./
COPY tunnelwire/go.mod tunnelwire/go.sum ./tunnelwire/
RUN go mod download
COPY . .

ARG VERSION=dev
ARG TARGETARCH=amd64
ARG TARGETVARIANT=
RUN GOARM="" && \
    if [ "${TARGETARCH}" = "arm" ]; then GOARM="${TARGETVARIANT#v}"; fi && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOARM=${GOARM} go build \
    -trimpath -buildvcs=false \
    -ldflags="-s -w -buildid= -X github.com/seawise/client/internal/constants.Version=${VERSION}" \
    -o /seawise-agent ./cmd/seawise-agent

# Runtime stage
FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d

RUN apk add --no-cache ca-certificates su-exec && \
    mkdir -p /config && chown 1000:1000 /config

COPY --from=builder /seawise-agent /app/seawise-agent
COPY entrypoint-agent.sh /app/entrypoint.sh
RUN chmod 0755 /app/entrypoint.sh /app/seawise-agent

ARG VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/seawise-io/seawise-client" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      io.seawise.line="2"

ENV SEAWISE_DATA_DIR=/config
VOLUME ["/config"]
WORKDIR /config
EXPOSE 8082

# /healthz answers plain HTTP to loopback peers only
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${SEAWISE_PORT:-8082}/healthz" || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
